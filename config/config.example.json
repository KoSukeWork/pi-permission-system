{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "yoloMode": false,
  "authorizerChain": [],
  "permission": {
    "*": "allow",
    "path": {
      "*": "allow",
      "*.env": "ask",
      "*.env.*": "ask",
      "*.env.example": "allow",
      "~/.ssh/*": "ask",
      "~/.pi/agent/settings.json": "ask"
    },
    "external_directory": "ask",
    "bash": {
      "*": "allow",
      "rm -r *": "ask",
      "rm -rf *": "ask",
      "rm -fr *": "ask",
      "sudo *": "ask"
    }
  }
}
